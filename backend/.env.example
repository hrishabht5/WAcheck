PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change_me_before_exposing_to_any_network

# ─── Anti-Ban Rate Limiting ────────────────────────────────────────────────────

# Mode A — Scraping Engine (whatsapp-web.js)
# Delay between individual lookups (ms). Safe range: 1000–5000.
SCRAPING_MIN_DELAY_MS=1500
SCRAPING_MAX_DELAY_MS=4000
# After every N numbers, pause for a longer cooldown. Safe range: 25–100.
SCRAPING_COOLDOWN_EVERY=50
# Duration of the cooldown (ms). Safe range: 10000–60000.
SCRAPING_COOLDOWN_MIN_MS=15000
SCRAPING_COOLDOWN_MAX_MS=30000
# Max lookups per WhatsApp session. Resets on reconnect. Safe range: 100–500.
SCRAPING_SESSION_LIMIT=300
# Retries per number before marking as error.
SCRAPING_MAX_RETRIES=3
# Exponential backoff timing on errors (ms). Doubles each retry, capped at MAX.
SCRAPING_BACKOFF_BASE_MS=2000
SCRAPING_BACKOFF_MAX_MS=30000

# Mode B — WABA Engine (Meta Graph API)
# Delay between 50-number batches (ms). Safe range: 500–5000.
WABA_MIN_BATCH_DELAY_MS=800
WABA_MAX_BATCH_DELAY_MS=2000
# Consecutive batch failures before aborting the job.
WABA_MAX_CONSECUTIVE_ERRORS=5
# Wait time when Meta returns 429 with no Retry-After header (ms).
WABA_RETRY_AFTER_DEFAULT_MS=60000
# Exponential backoff timing on batch errors (ms).
WABA_BACKOFF_BASE_MS=3000
WABA_BACKOFF_MAX_MS=60000
